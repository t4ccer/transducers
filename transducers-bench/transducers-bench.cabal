cabal-version:      3.0
name:               transducers-bench
version:            1.0.0
author:             Tomasz Maciosowski <t4ccer@gmail.com>
license:            AGPL-3.0-or-later
extra-source-files: README.md

common lang
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DerivingStrategies
    DerivingVia
    FunctionalDependencies
    GADTs
    LambdaCase
    LexicalNegation
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoImplicitPrelude
    NoMonomorphismRestriction
    NoStarIsType
    NumDecimals
    OverloadedLabels
    OverloadedLists
    OverloadedStrings
    PackageImports
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    RankNTypes
    RecursiveDo
    RoleAnnotations
    TypeFamilies
    TypeFamilyDependencies
    UnliftedFFITypes
    UnliftedNewtypes
    ViewPatterns

  build-depends:      base >=4.9 && <5
  ghc-options:
    -Weverything -Werror -Wno-unused-do-bind -Wno-implicit-prelude
    -Wno-name-shadowing -Wno-unsafe -Wno-missing-safe-haskell-mode
    -Wno-missing-local-signatures -Wno-monomorphism-restriction
    -Wno-missed-specialisations -Wno-all-missed-specializations
    -Wno-unrecognised-pragmas -Wno-operator-whitespace
    -fprint-equality-relations -fprint-explicit-kinds
    -fprint-explicit-foralls -fno-show-error-context
    -fhide-source-paths

benchmark bench
  import:         lang
  type:           exitcode-stdio-1.0
  main-is:        Bench.hs
  hs-source-dirs: bench
  build-depends:
    , tasty
    , tasty-bench
    , transducers-core
